# ==========================================
# ENVIRONMENT VARIABLES - SECURITY CONFIGURATION
# ==========================================
# 
# CRITICAL: Never commit this file to version control!
# Copy this to .env and fill in your actual values
# 

# Server Configuration
NODE_ENV=production
PORT=3000

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# API Keys (Keep these SECRET!)
# ==========================================

# GitHub API Token (Optional - for higher rate limits)
# Get yours at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only)
GITHUB_TOKEN=your_github_token_here

# Count API Configuration
# Visit: https://countapi.xyz/ to set up your counter
COUNT_API_URL=https://api.countapi.xyz/hit/your-namespace/your-key

# Email Service Configuration (for contact form)
# Example: SendGrid, AWS SES, Mailgun, etc.
EMAIL_SERVICE_API_KEY=your_email_service_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_TO=your-email@example.com

# Rate Limiting Configuration
# Adjust these values based on your needs
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Secret (for future authentication features)
SESSION_SECRET=your_super_secret_random_string_here

# Security Headers
HELMET_CSP_REPORT_URI=https://yourdomain.com/csp-report

# ==========================================
# KEY ROTATION SCHEDULE
# ==========================================
# 
# IMPORTANT: Rotate all API keys regularly!
# Recommended schedule:
# - GitHub Token: Every 90 days
# - Email API Keys: Every 90 days
# - Session Secret: Every 180 days
# 
# Last Rotation Date: [Add date when you rotate keys]
# Next Rotation Due: [Add date for next rotation]
# 

# ==========================================
# SECURITY NOTES
# ==========================================
# 
# 1. Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 2. Never share these credentials in public repositories
# 3. Use different values for development and production
# 4. Enable 2FA on all service accounts
# 5. Monitor API usage for suspicious activity
# 6. Set up alerts for failed authentication attempts
# 
