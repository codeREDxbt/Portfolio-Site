{
  "name": "portfolio-site-secure",
  "version": "1.0.0",
  "description": "Secure portfolio site with hardened backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier \"{.github,test}/**/*.{yml,yaml,js}\" \"*.{json,cjs}\" \"server.js\" \"vercel.json\" --write",
    "format:check": "prettier \"{.github,test}/**/*.{yml,yaml,js}\" \"*.{json,cjs}\" \"server.js\" \"vercel.json\" --check",
    "test": "node --test"
  },
  "keywords": [
    "portfolio",
    "express",
    "security"
  ],
  "author": "codeRED",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-mongo-sanitize": "^2.2.0",
    "express-validator": "^7.0.1",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "node-cache": "^5.1.2",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "nodemon": "^3.0.2",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  }
}
