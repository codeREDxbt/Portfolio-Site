{
  "name": "portfolio-site-secure",
  "version": "1.0.0",
  "description": "Secure portfolio site with hardened backend API",
  "main": "server.js",
  "scripts": {
    "dev": "npx vercel dev",
    "test": "echo \"No test suite configured\" && exit 0",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier \"{.github,test}/**/*.{yml,yaml,js}\" \"*.{json,cjs}\" \"vercel.json\" --write",
    "format:check": "prettier \"{.github,test}/**/*.{yml,yaml,js}\" \"*.{json,cjs}\" \"vercel.json\" --check"
  },
  "keywords": [
    "portfolio",
    "vercel"
  ],
  "author": "codeRED",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.6.2"
  }
}
